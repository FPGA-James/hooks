#!/usr/bin/env sh
# Validate the commit message against Conventional Commits.
set -u
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$HOOK_DIR/lib/common.sh"

[ "${commit_msg_enforce:-1}" = "1" ] || exit 0

msg_file=$1

# `git commit -v` / commit.verbose=true appends a scissors marker and the diff
# to the message file, and strips them only AFTER this hook runs. Cut that
# section first, mirroring git's own cleanup, so neither the subject nor the
# body check ever sees the diff.
msg=$(sed '/^# -\{2,\} >8 -\{2,\}/,$d' "$msg_file" | grep -vE '^[[:space:]]*#' | sed -e '/./,$!d')

subject=$(printf '%s\n' "$msg" | grep -vE '^[[:space:]]*$' | head -n1)

case $subject in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"") exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

if ! printf '%s\n' "$subject" | grep -Eq "^(${types})(\([a-z0-9._/-]+\))?(!)?: .+"; then
  log_error "commit message is not Conventional Commits"
  log_error "  got:      $subject"
  log_error "  want:     <type>(<scope>)?: <subject>   e.g. feat(uart): add parity bit"
  log_error "  types:    ${types}"
  exit 1
fi

body=${subject#*: }
len=$(printf '%s' "$body" | wc -m | tr -d ' ')
limit=${commit_msg_max_subject:-72}
if [ "$len" -gt "$limit" ]; then
  log_error "commit subject is ${len} characters; limit is ${limit}"
  exit 1
fi

# $msg is the scissors section cut, comment lines removed and leading blank
# lines trimmed, so line 1 is the subject and line 2 (if a body follows) must
# be blank.
if printf '%s\n' "$msg" | sed -n '2,$p' | grep -qvE '^[[:space:]]*$'; then
  line2=$(printf '%s\n' "$msg" | sed -n '2p')
  if ! printf '%s\n' "$line2" | grep -qE '^[[:space:]]*$'; then
    log_error "commit body must start after a blank line"
    log_error "  line 2:   $line2"
    log_error "  leave a blank line between the subject and the body"
    exit 1
  fi
fi

exit 0
