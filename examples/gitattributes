# HDL / shell line endings — keep stable across macOS and Linux so the
# formatters and header stamps behave identically.
*.sv     text eol=lf
*.svh    text eol=lf
*.v      text eol=lf
*.vh     text eol=lf
*.vhd    text eol=lf
*.vhdl   text eol=lf
*.sh     text eol=lf
*.f      text eol=lf
Makefile text eol=lf
