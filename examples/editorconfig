# Indentation matching verible-verilog-format / vsg defaults, so editors and
# the hooks agree. (`root = true` is dropped when this is merged into an
# existing .editorconfig.)
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{sv,svh,v,vh}]
indent_style = space
indent_size = 2

[*.{vhd,vhdl}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
